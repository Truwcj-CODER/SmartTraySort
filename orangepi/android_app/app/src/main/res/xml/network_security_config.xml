<?xml version="1.0" encoding="utf-8"?>
<!-- Server chay HTTP tran trong mang noi bo, khong co chung chi TLS. Mo dung
     cho HTTP thuong, phan con lai cua app van bat buoc HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
