# Chep thanh .env roi sua cho dung may cua ban.
# gia tri nao. Thieu mot dong la server dung ngay va noi ro thieu dong nao.

# Ket noi toi PLC
PLC_HOST=192.168.0.10
PLC_PORT=502
PLC_UNIT=1
PLC_CONNECT_TIMEOUT=3

# Tu gan dia chi cung dai voi PLC len card mang co day
NET_SETUP=1
PLC_LOCAL_IP=
PLC_LOCAL_PREFIX=24
PLC_IFACE=
PLC_NET_INTERVAL=5

# Nhip doc trang thai va thoi gian cho lenh, giay
POLL_INTERVAL=0.2
COMMAND_TIMEOUT=120
HOMING_TIMEOUT=180

# Web
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# MySQL - chay ngay trong compose nay. Container app dung mang host nen noi
# toi 127.0.0.1; doi MYSQL_HOST neu muon tro ra may khac.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=traysort
MYSQL_USER=traysort
MYSQL_PASSWORD=doi-mat-khau-nay
MYSQL_ROOT_PASSWORD=doi-mat-khau-nay-nua
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READY_TIMEOUT=60
